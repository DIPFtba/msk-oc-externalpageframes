{
	"title": "FreePaintRecog",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"___freePaint": {
			"title": "PaintArea",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {
				"x": {
					"title": "X",
					"type": "integer",
					"minimum": 0,
					"default": 2,
					"options": {
						"grid_columns": 4
					}
				},
				"y": {
					"title": "Y",
					"type": "integer",
					"minimum": 0,
					"default": 2,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},
				"width": {
					"title": "Breite",
					"type": "integer",
					"default": -2,
					"options": {
						"grid_columns": 4,
						"infoText": "Wenn negativ: relativ zu rechtem Rand"
					}
				},
				"height": {
					"title": "Höhe",
					"type": "integer",
					"default": -2,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Wenn negativ: relativ zu rechtem Rand"
					}
				},
				"frameWidth": {
					"title": "Rahmendicke",
					"type": "integer",
					"minimum": 0,
					"default": 2,
					"options": {
						"grid_columns": 4
					}
				},
				"frameRadius": {
					"title": "Rahmen-Radius",
					"type": "integer",
					"minimum": 0,
					"default": 3,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},
				"clip": {
					"title": "Rahmen begr. Pinsel",
					"type": "boolean",
					"format": "checkbox",
					"default": true,
					"options": {
						"grid_columns": 4,
						"infoText": "Wenn aktiviert, kann Pinsel nur innerhalb des Rahmens zeichenn, sonst auch darüber hinaus"
					}
				},
				"doFill": {
					"title": "Füllung",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},
				"frameColor": {
					"title": "Rahmenfarbe",
					"type": "string",
					"format": "color",
					"default": "#000000",
					"options": {
						"grid_columns": 4
					}
				},
				"fill": {
					"title": "Füllung",
					"type": "string",
					"format": "color",
					"default": "#ffffff",
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"dependencies": {
							"doFill": true
						}
					}
				},

				"paintLine": {
					"title": "Startfarbe",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 8,
						"grid_break": true
					},
					"properties": {
						"strokeWidth": {
							"title": "Dicke",
							"type": "integer",
							"minimum": 1,
							"default": 1,
							"options": {
								"grid_columns": 6
							}
						},
						"stroke": {
							"title": "Farbe",
							"type": "string",
							"format": "color",
							"default": "#000000",
							"options": {
								"grid_columns": 6
							}
						}
					}
				},

				"readonly": {
					"title": "Alles unveränderbar",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				}
			}
		},

		"___extraLines": {
			"title": "Rechtecke / Linien",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"extraRects": {
					"title": "Extra-Rechtecke",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"infoText": "Zusätzliche Rechtecke. 'Füllg. Ebene' gibt die Ebene für Füllung an: 0=Keine Füllung, 1=Hintergund, 2=Vordergrund. 'begr. Pinsel' gibt an, ob Pinsel nur in diesem Rechteck malt"
					},
					"items": {
						"title": "ExtraRechteck",
						"type": "object",
						"format": "grid-strict",
						"options": {
							"disable_collapse": true,
							"disable_edit_json": true,
							"disable_properties": true
						},
						"properties": {
							"x": {
								"title": "x",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"y": {
								"title": "y",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"width": {
								"title": "Breite",
								"type": "integer",
								"minimum": 1,
								"default": 50
							},
							"height": {
								"title": "Höhe",
								"type": "integer",
								"minimum": 1,
								"default": 20
							},
							"w": {
								"title": "Dicke",
								"type": "integer",
								"minimum": 0,
								"default": 1
							},
							"r": {
								"title": "Radius",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"c": {
								"title": "Farbe",
								"type": "string",
								"format": "color",
								"default": "#000000"
							},
							"fl": {
								"title": "Füllg. Ebene",
								"type": "integer",
								"minimum": 0,
								"maximum": 2,
								"default": 0
							},
							"f": {
								"title": "Füllg. Farbe",
								"type": "string",
								"format": "color",
								"default": "#d3d3d3"
							},
							"clipBrush": {
								"title": "begr. Pinsel",
								"type": "boolean",
								"format": "checkbox",
								"default": false
							}
						}
					}
				},

				"extraLines": {
					"title": "Extra-Linien",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"infoText": "Feste Extra-Linien, die zusätzlich gezeichnet werden"
					},
					"items": {
						"title": "ExtraLinie",
						"type": "object",
						"options": {
							"disable_collapse": true,
							"disable_edit_json": true,
							"disable_properties": true
						},
						"properties": {
							"x1": {
								"title": "x1",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"y1": {
								"title": "y1",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"x2": {
								"title": "x2",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"y2": {
								"title": "y2",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"w": {
								"title": "Dicke",
								"type": "integer",
								"minimum": 1,
								"default": 1
							},
							"c": {
								"title": "Farbe",
								"type": "string",
								"format": "color",
								"default": "#000000"
							}
						}
					}
				}
			}
		},

		"myScript": {
			"title": "Recognition",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"withOut_sk": {
					"title": "Text ohne Einschränkung erkennen, in Variablen 'V_RecogTxt_&lt;prefix&gt;' speichern",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				},

				"sk_enabled_subsets": {
					"title": "Subsets",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true,
						"uniqueItems": true,
						"infoText": "Einschränkungen ('custom-sk Math Enabled Subsets') für die Erkennung, in Variablen 'V_RecogTxtX_<pref>', s. https://developer.myscript.com/docs/files/math-sk-symbols.txt"
					},
					"items": {
						"title": "Subset",
						"type": "string"
					},
					"default": ["0123456789+-*:="]
				}
			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type": "string",
							"default": "freePaintRecog"
						},
						"___version": {
							"type": "string",
							"default": "0.1"
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt wird 'V_Status_&lt;pref&gt;' und 'V_RecogTxt_&lt;pref&gt;' bzw. 'V_RecogTxtX_&lt;pref&gt;', s. Tab 'Recognition'",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				}
			}
		}
	}
}