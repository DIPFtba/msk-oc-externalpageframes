{
	"title": "ImageHighlighting",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"___global": {
			"title": "Darstellung",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"readonly": {
					"title": "Kein Markieren erlauben (Read-Only)",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 8,
						"grid_break": true
					}
				},

				"areaWidth": {
					"title": "Breite Image-Bereich",
					"type": "string",
					"default": "98%",
					"options": {
						"grid_columns": 4,
						"infoText": "Breite des Bildanzeigebereichs, z.B. '500px', '90vw', '95%'."
					}
				},
				"areaColor": {
					"title": "Farbe Image-Bereich",
					"type": "string",
					"format": "color",
					"default": "#e0e0e0",
					"options": {
						"grid_columns": 4,
						"infoText": "Farbe Hintergrund Bildanzeigebereich"
					}
				},
				"marginColor": {
					"title": "Farbe Rand-Bereich",
					"type": "string",
					"format": "color",
					"default": "#a0a0a0",
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Farbe Hintergrund Randbereich rechts"
					}
				},

				"___imgs": {
					"title": "Hintergrundbilder",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},

					"properties": {

						"gap": {
							"title": "Abstand Vertikal (xy%)",
							"type": "string",
							"default": "0.8%",
							"pattern": "^([0-9]+(\\.[0-9]+)?%)?$",
							"options": {
								"grid_columns": 4,
								"infoText": "Vertikaler Abstand oben/unten/zwischen mehreren Bildern (in %)"
							}
						},

						"imgs": {
							"title": "Bilder",
							"type": "array",
							"format": "table",
							"options": {
								"disable_collapse": true,
								"disable_edit_json": true,
								"disable_properties": true,
								"grid_columns": 12,
									"infoText": "Bilder in der gewünschten Reihenfolge hochladen, ggf. Breite spezifizieren (in %). Wenn 'Name in Logs' leer, dann wird bei jedem Init/State komplettes Base64 mit Größenangaben gesendet"
							},
							"items": {
								"title": "Bild",
								"type": "object",
								"format": "grid-strict",
								"options": {
									"disable_collapse": true,
									"disable_edit_json": true,
									"disable_properties": true
								},
								"properties": {
									"url": {
										"title": "Bild-URL",
										"type": "string",
										"media": {
											"binaryEncoding": "base64",
											"type": "image/*"
										}
									},
									"name": {
										"title": "Name in Logs",
										"type": "string"
									},
									"width": {
										"title": "Breite (xy%)",
										"type": "string",
										"pattern": "^([0-9]+(\\.[0-9]+)?%)?$"
									}
								}
							}
						}
					}
				},

				"highlight": {
					"title": "Highlighting",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},
					"properties": {

						"stroke": {
							"title": "Farbe",
							"type": "string",
							"format": "color",
							"default": "#ffff00",
							"options": {
								"grid_columns": 6
							}
						},

						"strokeWidth": {
							"title": "Dicke",
							"type": "integer",
							"minimum": 1,
							"default": 15,
							"options": {
								"grid_columns": 6,
								"grid_break": true
							}
						}
					}
				},

				"eraser": {
					"title": "Eraser",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},
					"properties": {

						"strokeWidth": {
							"title": "Dicke",
							"type": "integer",
							"minimum": 1,
							"default": 25,
							"options": {
								"grid_columns": 6
							}
						}
					}
				}

			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type": "string",
							"default": "imageHighlighting"
						},
						"___version": {
							"type": "string",
							"default": "0.3"
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt wird 'V_Status_&lt;pref&gt;'",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				},

				"hitAreas": {
					"title": "Hit-Areas",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12
					},
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"title": "Name",
								"type": "string"
							},
							"pos": {
								"title": "Positiv",
								"type": "string"
							},
							"posFill": {
								"title": "Min%",
								"type": "integer",
								"default": 70
							},
							"posBtn": {
								"title": "Edit",
								"type": "string",
								"format": "button",
								"options": {
									"button": {
										"action": "imageHighlightingHitAreaPosBtnAction",
										"text": "Edit"
									}
								}
							},
							"neg": {
								"title": "Negativ",
								"type": "string"
							},
							"negFill": {
								"title": "Min%",
								"type": "integer",
								"default": 10
							},
							"negBtn": {
								"title": "Edit",
								"type": "string",
								"format": "button",
								"options": {
									"button": {
										"action": "imageHighlightingHitAreaNegBtnAction",
										"text": "Edit"
									}
								}
							},
							"exp": {
								"title": "IB Var.",
								"type": "boolean",
								"format": "checkbox",
								"default": true
							}
						}
					}
				},

				"scoringVariables": {
					"title": "(interne) Scoring Variablen V_Score_&ltpref&gt;_&ltvarName&gt;",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Ausdruck, der ausgewertet wird, Ergebnis wird in VarName gespeichert. == ist gleich, logische Verknüpfung mehrerer Bedingungen möglich (or, and) | IB Variable: Soll Muster als Variable V_Score_<pref>_<VarName> im IB gespeichert werden?"
					},
					"items": {
						"title": "Scoring Variable",
						"type": "object",
						"properties": {
							"name": {
								"title": "VarName",
								"type": "string",
								"pattern": "^[a-zA-Z0-9_]+$"
							},
							"condition": {
								"title": "Ausdruck (VarNamen in ${} setzen)",
								"type": "string",
								"format": "textarea"
							},
							"exp": {
								"title": "IB Variable",
								"type": "boolean",
								"format": "checkbox",
								"default": true
							}
						}
					}
				},

				"scoringVals": {
					"title": "Scoring Werte für V_Score_&ltpref&gt;",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Scoring-Wert der ersten wahren Bedingung wird evaluiert. Bedingung: == ist gleich, logische Verknüpfung mehrerer Bedingungen möglich (or, and)"
					},
					"items": {
						"title": "Scoring Wert",
						"type": "object",
						"properties": {
							"val": {
								"title": "Scoring-Wert",
								"type": "integer"
							},
							"condition": {
								"title": "Bedingung (VarNamen in ${} setzen)",
								"type": "string",
								"format": "textarea"
							}
						}
					}
				}
			}
		}
	}
}
