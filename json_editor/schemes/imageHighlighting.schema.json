{
	"title": "ImageHighlighting",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"___global": {
			"title": "Darstellung",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"readonly": {
					"title": "Kein Markieren erlauben (Read-Only)",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 8,
						"grid_break": true
					}
				},

				"areaWidth": {
					"title": "Breite Image-Bereich",
					"type": "string",
					"default": "98%",
					"options": {
						"grid_columns": 4,
						"infoText": "Breite des Bildanzeigebereichs, z.B. '500px', '90vw', '95%'."
					}
				},
				"areaColor": {
					"title": "Farbe Image-Bereich",
					"type": "string",
					"format": "color",
					"default": "#e0e0e0",
					"options": {
						"grid_columns": 4,
						"infoText": "Farbe Hintergrund Bildanzeigebereich"
					}
				},
				"marginColor": {
					"title": "Farbe Rand-Bereich",
					"type": "string",
					"format": "color",
					"default": "#a0a0a0",
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Farbe Hintergrund Randbereich rechts"
					}
				},

				"___imgs": {
					"title": "Hintergrundbilder",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},

					"properties": {

						"gap": {
							"title": "Abstand Vertikal",
							"type": "number",
							"minimum": 0,
							"default": 10,
							"options": {
								"grid_columns": 4,
								"infoText": "Vertikaler Abstand oben/unten/zwischen mehreren Bildern in Pixeln"
							}
						},

						"imgs": {
							"title": "Bilder",
							"type": "array",
							"format": "table",
							"options": {
								"disable_collapse": true,
								"disable_edit_json": true,
								"disable_properties": true,
								"grid_columns": 12,
									"infoText": "Bilder in der gewünschten Reihenfolge hochladen, ggf. Breite spezifizieren (px oder %). Wenn 'Name in Logs' leer, dann wird bei jedem Init komplettes Base64 mit Größenangaben gesendet"
							},
							"items": {
								"title": "Bild",
								"type": "object",
								"format": "grid-strict",
								"options": {
									"disable_collapse": true,
									"disable_edit_json": true,
									"disable_properties": true
								},
								"properties": {
									"url": {
										"title": "Bild-URL",
										"type": "string",
										"media": {
											"binaryEncoding": "base64",
											"type": "image/*"
										}
									},
									"name": {
										"title": "Name in Logs",
										"type": "string"
									},
									"width": {
										"title": "Breite",
										"type": "string"
									}
								}
							}
						}
					}
				},

				"highlight": {
					"title": "Highlighting",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},
					"properties": {

						"stroke": {
							"title": "Farbe",
							"type": "string",
							"format": "color",
							"default": "#ffff00",
							"options": {
								"grid_columns": 6
							}
						},

						"strokeWidth": {
							"title": "Dicke",
							"type": "integer",
							"minimum": 1,
							"default": 15,
							"options": {
								"grid_columns": 6,
								"grid_break": true
							}
						}
					}
				},

				"eraser": {
					"title": "Eraser",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true
					},
					"properties": {

						"strokeWidth": {
							"title": "Dicke",
							"type": "integer",
							"minimum": 1,
							"default": 25,
							"options": {
								"grid_columns": 6
							}
						}
					}
				}

			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type": "string",
							"default": "imageHighlighting"
						},
						"___version": {
							"type": "string",
							"default": "0.2"
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt wird 'V_Status_&lt;pref&gt;'",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				},

				"hitAreas": {
					"title": "Hit-Areas",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12
					},
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"title": "Name",
								"type": "string",
								"options": {
									"grid_columns": 6
								}
							},
							"pos": {
								"title": "Positiv",
								"type": "string"
							},
							"posBtn": {
								"title": "Edit",
								"type": "string",
								"format": "button",
								"options": {
									"button": {
										"action": "imageHighlightingHitAreaPosBtnAction",
										"text": "Edit"
									}
								}
							},
							"neg": {
								"title": "Negativ",
								"type": "string"
							},
							"negBtn": {
								"title": "Edit",
								"type": "string",
								"format": "button",
								"options": {
									"button": {
										"action": "imageHighlightingHitAreaNegBtnAction",
										"text": "Edit"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
