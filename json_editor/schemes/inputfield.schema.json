{
	"title": "Inputfield",
	"type": "object",
	"format": "categories",
	"options": {
		"remove_empty_properties": true,
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"options": {
			"title": "Eigenschaften",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"remove_empty_properties": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"width": {
					"title": "Breite",
					"type": "string",
					"default": "",
					"options": {
						"grid_columns": 4
					}
				},
				"height": {
					"title": "Höhe",
					"type": "string",
					"default": "",
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},

				"pdp": {
					"title": "Vorkomma-Stellen",
					"type": "integer",
					"minimum": 0,
					"default": 0,
					"options": {
						"grid_columns": 4,
						"infoText": "Wenn >0: max. Stellenanzahl (dann nur Zahleneingaben erlaubt)"
					}
				},
				"dp": {
					"title": "Nachkomma-Stellen",
					"type": "integer",
					"minimum": 0,
					"default": 0,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Wenn >0: max. Nachkomma-Stellen (dann nur Zahleneingaben erlaubt)"
					}
				},

				"maxlength": {
					"title": "Maximale Anzahl Zeichen",
					"type": "integer",
					"minimum": 0,
					"options": {
						"grid_columns": 4,
						"infoText": "0 = keine Begrenzung, wenn > 0: Eingabe wird auf diese Länge begrenzt"
					}
				},
				"inputRegexp": {
					"title": "Eingabe-RegExp",
					"type": "string",
					"default": "",
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Regulärer Ausdruck, der auf die Eingabe angewendet wird (wenn keine Vor-/Nachkommastellen angegeben). leer = keine Einschränkung"
					}
				},

				"fontFile": {
					"title": "Schriftart",
					"type": "string",
					"default": "",
					"format": "font",
					"options": {
						"grid_break": true,
						"grid_columns": 4,
						"infoText": "relativer Pfad (zur Laufzeit!) zur Schriftart-Datei, die für die Eingabefelder verwendet werden soll. Wenn leer, dann wird die Standard-Schriftart verwendet"
					}
				},

				"stylesDefault": {
					"title": "Styles DEFAULT",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"collapsed": true,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {

						"fontSize": {
							"title": "Schriftgröße",
							"type": "string",
							"default": "",
							"options": {
								"grid_columns": 4,
								"infoText": "Wenn leer, dann wird die Standard-Schriftgröße verwendet"
							}
						},
						"fontWeight": {
							"title": "Schriftstärke",
							"type": "string",
							"default": "",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"infoText": "z.B. 'normal', 'bold', '100', '200', ..., '900'. Wenn leer, dann wird die Standard-Schriftstärke verwendet"
							}
						},

						"borderWidth": {
							"title": "Rahmendicke",
							"type": "string",
							"default": "1",
							"options": {
								"grid_columns": 4
							}
						},
						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"format": "color",
							"default": "#000000",
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmenradius",
							"type": "string",
							"default": "5",
							"options": {
								"grid_break": true,
								"grid_columns": 4
							}
						},

						"_set_backgroundColor": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"format": "checkbox",
							"default": false,
							"options": {
								"grid_columns": 4
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"format": "color",
							"default": "#FFFFFF",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"dependencies": {
									"_set_backgroundColor": true
								}
