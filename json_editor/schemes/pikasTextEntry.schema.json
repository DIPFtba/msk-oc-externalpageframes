{
	"title": "Eingabefelder",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"options": {
			"title": "Eigenschaften",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"readonly": {
					"title": "Alles unveränderbar",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}

				},

				"width": {
					"title": "Breite der Felder",
					"type": "integer",
					"minimum": 10,
					"default": 100,
					"options": {
						"grid_columns": 4,
						"infoText": "Defaultwert, kann pro Feld angepasst werden"
					}
				},
				"height": {
					"title": "Höhe der Felder",
					"type": "integer",
					"minimum": 10,
					"default": 40,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Defaultwert, kann pro Feld angepasst werden"
					}
				},

				"fontSize": {
					"title": "Schriftgröße",
					"type": "integer",
					"minimum": 5,
					"default": 25,
					"options": {
						"grid_columns": 4
					}
				},
				"padding": {
					"title": "Innenabstand",
					"type": "integer",
					"minimum": 0,
					"default": 2,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},
				"minFontSize": {
					"title": "Minimale Schriftgröße",
					"type": "integer",
					"minimum": 0,
					"default": 0,
					"options": {
						"grid_break": true,
						"grid_columns": 4,
						"infoText": "Wenn > 0: Schriftgröße wird bis zu diesem Wert verringert, wenn der Text zu breit für Feld ist"
					}
				},
				"fontFile": {
					"title": "Schriftart",
					"type": "string",
					"default": "",
					"format": "font",
					"options": {
						"grid_break": true,
						"grid_columns": 4,
						"infoText": "relativer Pfad (zur Laufzeit!) zur Schriftart-Datei, die für die Eingabefelder verwendet werden soll. Wenn leer, dann wird die Standard-Schriftart verwendet"
					}
				},
				"fontBold": {
					"title": "Schriftart Fett darstellen",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_break": true,
						"grid_columns": 4,
						"dependencies": {
							"fontFile": true
						}
					}
				},

				"cursorAlwaysRight": {
					"title": "Cursor immer rechts",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Cursor wird immer am rechten Ende des Textes positioniert (sonst an der Stelle des Klicks)"
					}
				},
				"deleteAll":{
					"title": "DELETE/DELBAK löscht gesamten Inhalt",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Bei Aktivierung wird beim Drücken der Löschen/Delbak-Taste immer der gesamte Inhalt des Feldes gelöscht (sonst nur ein Zeichen)"
					}
				},
				"navPrevDelbak": {
					"title": "Bei leerem Feld mit Delbak zu vorherigem Feld",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Wenn das Feld leer ist oder Cursor links steht und die Rücktaste (Delbak) gedrückt wird, wird zum vorherigen Feld gewechselt"
					}
				},
				"navNextFull": {
					"title": "Bei voller Eingabe zu nächstem Feld",
					"type": "boolean",
					"format": "checkbox",
					"default": false,
					"options": {
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Wenn die maximale Eingabelänge eines Feldes erreicht ist, wird automatisch zum nächsten Feld gewechselt"
					}
				},

				"blurOnEnter": {
					"title": "Eingabe bei Enter bestätigen",
					"type": "boolean",
					"format": "checkbox",
					"default": true,
					"options": {
						"grid_columns": 4
					}
				},
				"navNextOnEnter": {
					"title": "Enter navigiert zu nächstem Feld",
					"type": "boolean",
					"format": "checkbox",
					"default": true,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"dependencies": {
							"blurOnEnter": true
						}
					}
				},
				"revertOnEsc": {
					"title": "Eingabe bei Esc verwerfen",
					"type": "boolean",
					"format": "checkbox",
					"default": true,
					"options": {
						"grid_columns": 4,
						"grid_break": true
					}
				},

				"pdp": {
					"title": "Vorkomma-Stellen",
					"type": "integer",
					"minimum": 0,
					"default": 0,
					"options": {
						"grid_columns": 4,
						"infoText": "Wenn >0: max. Stellenanzahl (dann nur Zahleneingaben erlaubt)"
					}
				},
				"dp": {
					"title": "Nachkomma-Stellen",
					"type": "integer",
					"minimum": 0,
					"default": 0,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "Wenn >0: max. Nachkomma-Stellen (dann nur Zahleneingaben erlaubt)"
					}
				},

				"maxlength": {
					"title": "Maximale Anzahl Zeichen",
					"type": "integer",
					"minimum": 0,
					"options": {
						"grid_columns": 4,
						"infoText": "0 = keine Begrenzung, wenn > 0: Eingabe wird auf diese Länge begrenzt"
					}
				},
				"inputRegexp": {
					"title": "Eingabe-RegExp",
					"type": "string",
					"default": "",
					"options": {
						"grid_columns": 4,
						"infoText": "Regulärer Ausdruck, der auf die Eingabe angewendet wird (wenn keine Vor-/Nachkommastellen angegeben). leer = keine Einschränkung"
					}
				},

				"stylesNormal": {
					"title": "Styles normal",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {
						"setBG": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"default": false,
							"format": "checkbox",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"default": "#ffffff",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"dependencies": {
									"setBG": true
								}
							}
						},
						"color": {
							"title": "Textfarbe",
							"type": "string",
							"default": "#000000",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},

						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"default": "#c0c0c0",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderWidth": {
							"title": "Rahmenbreite",
							"type": "integer",
							"default": 1,
							"minimum": 0,
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmen-Radius",
							"type": "integer",
							"default": 0,
							"minimum": 0,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderStyle": {
							"type": "string",
							"default": "solid",
							"options": {
								"hidden": true
							}
						}
					}
				},

				"stylesHover": {
					"title": "Styles bei Maushover",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {
						"setBG": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"default": false,
							"format": "checkbox",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"default": "#ffffff",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"dependencies": {
									"setBG": true
								}
							}
						},
						"color": {
							"title": "Textfarbe",
							"type": "string",
							"default": "#000000",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},

						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"default": "#ffff00",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderWidth": {
							"title": "Rahmenbreite",
							"type": "integer",
							"default": 1,
							"minimum": 0,
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmen-Radius",
							"type": "integer",
							"default": 0,
							"minimum": 0,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderStyle": {
							"type": "string",
							"default": "solid",
							"options": {
								"hidden": true
							}
						}
					}
				},

				"stylesFocus": {
					"title": "Styles bei Focus",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {
						"setBG": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"default": false,
							"format": "checkbox",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"default": "#ffffff",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"dependencies": {
									"setBG": true
								}
							}
						},
						"color": {
							"title": "Textfarbe",
							"type": "string",
							"default": "#000000",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},

						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"default": "#ff0000",
							"format": "color",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderWidth": {
							"title": "Rahmenbreite",
							"type": "integer",
							"default": 1,
							"minimum": 0,
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmen-Radius",
							"type": "integer",
							"default": 0,
							"minimum": 0,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						},
						"borderStyle": {
							"type": "string",
							"default": "solid",
							"options": {
								"hidden": true
							}
						}
					}
				}
			}
		},

		"___fields": {
			"title": "Positionierungen",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"remove_empty_properties": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"fields": {
					"title": "Eingabefelder",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"infoText": "Definitionen der Eingabefelder. Wenn Breite/Höhe leer, dann wird die Default-Breite/Höhe verwendet. 'Prev-/NextIdx' gibt Index 1-n des vorherigen/nächsten Feldes an. 'Fest' bedeutet 'Unveränderbar'. 'VarName' wird Teil des IB-Variablen-Namens (wenn alle leer = Index wird verwendet)"
					},
					"items": {
						"title": "Eingabefeld",
						"type": "object",
						"format": "grid-strict",
						"options": {
							"remove_empty_properties": true,
							"disable_collapse": true,
							"disable_edit_json": true,
							"disable_properties": true
						},
						"properties": {

							"x": {
								"title": "x",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"y": {
								"title": "y",
								"type": "integer",
								"minimum": 0,
								"default": 0
							},
							"width": {
								"title": "Breite",
								"type": "string"
							},
							"height": {
								"title": "Höhe",
								"type": "string"
							},
							"value": {
								"title": "Vorbelegung",
								"type": "string",
								"default": ""
							},
							"inputRegexp": {
								"title": "RegExp",
								"type": "string",
								"default": ""
							},
							"navPrev": {
								"title": "PrevIdx",
								"type": "string",
								"default": ""
							},
							"navNext": {
								"title": "NextIdx",
								"type": "string",
								"default": ""
							},
							"readonly": {
								"title": "Fest",
								"type": "boolean",
								"format": "checkbox",
								"default": false
							},
							"varName": {
								"title": "VarName",
								"type": "string",
								"default": ""
							}
						}
					}
				}
			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type": "string",
							"default": "pikasTextEntry"
						},
						"___version": {
							"type": "string",
							"default": "0.1"
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"type": "string",
					"description": "Erzeugt werden 'V_Status_&lt;pref&gt;', 'V_Input_&lt;pref&gt;_X' und 'V_Score_&lt;pref&gt;'",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				},

				"createInpAllVars": {
					"title": "Erzeuge V_Status_&lt;pref&gt;_All Status-Variable",
					"type": "boolean",
					"format": "checkbox",
					"options": {
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Erzeuge zusätzliche Status-Variable, die angibt, ob in alle Felder Text eingegeben wurde"
					}
				},

				"scoringVariables": {
					"title": "(interne) Scoring Variablen V_Score_&ltpref&gt;_&ltvarName&gt;",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Ausdruck, der ausgewertet wird, Ergebnis wird in VarName gespeichert. == ist gleich, logische Verknüpfung mehrerer Bedingungen möglich (or, and) | IB Variable: Soll Muster als Variable V_Score_<pref>_<VarName> im IB gespeichert werden?"
					},
					"items": {
						"title": "Scoring Variable",
						"type": "object",
						"properties": {
							"name": {
								"title": "VarName",
								"type": "string",
								"pattern": "^[a-zA-Z0-9_]+$"
							},
							"condition": {
								"title": "Ausdruck (VarNamen in ${} setzen)",
								"type": "string",
								"format": "textarea"
							},
							"exp": {
								"title": "IB Variable",
								"type": "boolean",
								"format": "checkbox",
								"default": true
							}
						}
					}
				},

				"scoringVals": {
					"title": "Scoring Werte für V_Score_&ltpref&gt;",
					"type": "array",
					"format": "table",
					"options": {
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"grid_columns": 12,
						"grid_break": true,
						"infoText": "Scoring-Wert der ersten wahren Bedingung wird evaluiert. Bedingung: == ist gleich, logische Verknüpfung mehrerer Bedingungen möglich (or, and)"
					},
					"items": {
						"title": "Scoring Wert",
						"type": "object",
						"properties": {
							"val": {
								"title": "Scoring-Wert",
								"type": "integer"
							},
							"condition": {
								"title": "Bedingung (VarNamen in ${} setzen)",
								"type": "string",
								"format": "textarea"
							}
						}
					}
				}
			}

		}

	}
}
