{
	"title": "Ratings",
	"type": "object",
	"format": "categories",
	"options": {
		"remove_empty_properties": true,
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"ratings": {
			"title": "Ratings",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"remove_empty_properties": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"container": {
					"title": "Container Stil",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"collapsed": false,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {

						"width": {
							"title": "Breite",
							"type": "integer",
							"minimum": 10,
							"options": {
								"grid_columns": 4
							},
							"default": 400
						},
						"height": {
							"title": "Höhe",
							"type": "integer",
							"minimum": 10,
							"options": {
								"grid_columns": 4
							},
							"default": 100
						},
						"imgWidth": {
							"title": "Icongröße",
							"type": "integer",
							"minimum": 10,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							},
							"default": 50
						},

						"borderWidth": {
							"title": "Rahmendicke",
							"type": "string",
							"default": "1",
							"options": {
								"grid_columns": 4
							}
						},
						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"format": "color",
							"default": "#c0c0c0",
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmenradius",
							"type": "string",
							"default": "20",
							"options": {
								"grid_break": true,
								"grid_columns": 4
							}
						},

						"_set_backgroundColor": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"format": "checkbox",
							"default": false,
							"options": {
								"grid_columns": 4
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"format": "color",
							"default": "#FFFFFF",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"dependencies": {
									"_set_backgroundColor": true
								}
							}
						}
					}
				},

				"colors": {
					"title": "Farben",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"collapsed": false,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {
						"normal": {
							"title": "Normal",
							"type": "string",
							"format": "color",
							"default": "#FFFFFF",
							"options": {
								"grid_columns": 4
							}
						},
						"marked": {
							"title": "Markiert",
							"type": "string",
							"format": "color",
							"default": "#FFD700",
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						}
					}
				},

				"defs": {
					"title": "Ratings",
					"type": "array",
					"format": "table",
					"options": {
						"uniqueItems": true,
						"grid_columns": 4,
						"titleHidden": false,
						"disable_collapse": true,
						"disable_edit_json": true,
						"disable_properties": true,
						"infoText": "Bestimmte Reihenfolge und Namen der SVGs und Variablen definieren"
					},
					"items": {
						"title": "Rating",
						"type": "object",
						"format": "table",
						"options": {
							"grid_columns": 12,
							"titleHidden": true,
							"disable_collapse": true,
							"disable_edit_json": true,
							"disable_properties": true
						},
						"properties": {
							"name": {
								"title": "Name",
								"type": "string",
								"options": {
									"grid_columns": 4
								}
							},
							"x": {
								"title": "Pos X",
								"type": "integer",
								"minimum": 0,
								"options": {
									"grid_columns": 4
								}
							},
							"y": {
								"title": "Pos Y",
								"type": "integer",
								"minimum": 0,
								"options": {
									"grid_columns": 4
								}
							}
						}
					},
					"default": [
						{ "name":"star", "x":10, "y":5 },
						{ "name":"barbell", "x":420, "y":5 }
					]
				}
			}
		},

		"buttons": {
			"title": "Buttons",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"remove_empty_properties": true,
				"disable_collapse": true,
				"collapsed": false,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"stil": {
					"title": "Stil",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"collapsed": false,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {

						"width": {
							"title": "Breite",
							"type": "integer",
							"minimum": 10,
							"options": {
								"grid_columns": 4
							},
							"default": 80
						},
						"height": {
							"title": "Höhe",
							"type": "integer",
							"minimum": 10,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							},
							"default": 30
						},

						"borderWidth": {
							"title": "Rahmendicke",
							"type": "string",
							"default": "",
							"options": {
								"grid_columns": 4
							}
						},
						"borderColor": {
							"title": "Rahmenfarbe",
							"type": "string",
							"format": "color",
							"default": "#c0c0c0",
							"options": {
								"grid_columns": 4
							}
						},
						"borderRadius": {
							"title": "Rahmenradius",
							"type": "string",
							"default": "",
							"options": {
								"grid_break": true,
								"grid_columns": 4
							}
						},

						"_set_backgroundColor": {
							"title": "Hintergrundfarbe setzen",
							"type": "boolean",
							"format": "checkbox",
							"default": true,
							"options": {
								"grid_columns": 4
							}
						},
						"backgroundColor": {
							"title": "Hintergrundfarbe",
							"type": "string",
							"format": "color",
							"default": "#e0e0e0",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"dependencies": {
									"_set_backgroundColor": true
								}
							}
						},

						"_set_color": {
							"title": "Textfarbe setzen",
							"type": "boolean",
							"format": "checkbox",
							"default": true,
							"options": {
								"grid_columns": 4
							}
						},
						"color": {
							"title": "Textfarbe",
							"type": "string",
							"format": "color",
							"default": "#000000",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"dependencies": {
									"_set_color": true
								}
							}
						},

						"fontFile": {
							"title": "Schriftart",
							"type": "string",
							"default": "",
							"format": "font",
							"options": {
								"grid_columns": 4,
								"infoText": "relativer Pfad (zur Laufzeit!) zur Schriftart-Datei, die für die Eingabefelder verwendet werden soll. Wenn leer, dann wird die Standard-Schriftart verwendet"
							}
						},
						"fontSize": {
							"title": "Schriftgröße",
							"type": "string",
							"default": "",
							"options": {
								"grid_columns": 4,
								"infoText": "Wenn leer, dann wird die Standard-Schriftgröße verwendet"
							}
						},
						"fontWeight": {
							"title": "Schriftstärke",
							"type": "string",
							"default": "",
							"options": {
								"grid_columns": 4,
								"grid_break": true,
								"infoText": "z.B. 'normal', 'bold', '100', '200', ..., '900'. Wenn leer, dann wird die Standard-Schriftstärke verwendet"
							}
						}
					}
				},

				"clear": {
					"title": "Clear-Button",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"collapsed": false,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {

						"text": {
							"title": "Text",
							"type": "string",
							"default": "Löschen",
							"options": {
								"grid_columns": 4
							}
						},
						"x": {
							"title": "Pos X",
							"type": "integer",
							"default": 375,
							"options": {
								"grid_columns": 4
							}
						},
						"y": {
							"title": "Pos Y",
							"type": "integer",
							"minimum": 0,
							"default": 120,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						}
					}
				},

				"submit": {
					"title": "Submit-Button",
					"type": "object",
					"format": "grid-strict",
					"options": {
						"disable_collapse": true,
						"collapsed": false,
						"grid_columns": 12,
						"remove_empty_properties": true,
						"disable_edit_json": true,
						"disable_properties": true
					},
					"properties": {

						"text": {
							"title": "Text",
							"type": "string",
							"default": "Weiter",
							"options": {
								"grid_columns": 4
							}
						},
						"x": {
							"title": "Pos X",
							"type": "integer",
							"default": 375,
							"options": {
								"grid_columns": 4
							}
						},
						"y": {
							"title": "Pos Y",
							"type": "integer",
							"default": 150,
							"options": {
								"grid_columns": 4,
								"grid_break": true
							}
						}
					}
				}
			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type":"string",
							"default":"ratings"
						},
						"___version": {
							"type":"number",
							"default":0.1
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt wird 'V_Status_&lt;pref&gt;' und 'V_Input_&lt;pref&gt;_&lt;nameX&gt;",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				}
			}
		}
	}
}












