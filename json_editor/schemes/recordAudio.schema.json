{
	"title": "RecordAudio",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"___audio": {
			"title": "Audios",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"width": {
					"title": "GesamtBreite",
					"type": "integer",
					"default": 0,
					"options": {
						"grid_columns": 4,
						"infoText": "0 = Fensterbreite, wenn <=0: relativ zu Fensterbreite"
					}
				},
				"height": {
					"title": "Höhe",
					"type": "integer",
					"default": 0,
					"options": {
						"grid_columns": 4,
						"grid_break": true,
						"infoText": "0 = Fensterhöhe, wenn <=0: relativ zu Fensterhöhe"
					}
				},

				"individualDelete": {
					"title": "Audios können einzeln gelöscht werden",
					"type": "boolean",
					"format": "checkbox",
					"default": true,
					"options": {
						"grid_columns": 4
					}
				}
			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type":"string",
							"default":"recordAudio"
						},
						"___version": {
							"type":"number",
							"default":0.1
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt wird 'V_Status_&lt;pref&gt;'",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				}
			}
		}
	}
}