{
	"title": "vueExamplePinia",
	"type": "object",
	"format": "categories",
	"options": {
		"disable_collapse": true,
		"disable_edit_json": true,
		"disable_properties": true
	},
	"properties": {

		"___options": {
			"title": "vueExamplePinia",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"titleHidden": true,
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"backgroundColor": {
					"title": "Hintergrundfarbe",
					"type": "string",
					"format": "color",
					"default": "#f0f0f0",
					"options": {
						"grid_columns": 6
					}
				},
				"textColor": {
					"title": "Textfarbe",
					"type": "string",
					"format": "color",
					"default": "#000000",
					"options": {
						"grid_columns": 6,
						"grid_break": true
					}
				},

				"width": {
					"title": "Breite",
					"type": "integer",
					"default": 500,
					"options": {
						"grid_columns": 6
					}
				},
				"height": {
					"title": "Höhe",
					"type": "integer",
					"default": 200,
					"options": {
						"grid_columns": 6,
						"grid_break": true
					}
				}
			}
		},

		"dataSettings": {
			"title": "Daten",
			"type": "object",
			"format": "grid-strict",
			"options": {
				"disable_collapse": true,
				"disable_edit_json": true,
				"disable_properties": true
			},
			"properties": {

				"___jsonSchemaData": {
					"type": "object",
					"properties": {
						"___name": {
							"type":"string",
							"default":"vueExamplePinia"
						},
						"___version": {
							"type":"number",
							"default":0.1
						}
					},
					"options": {
						"hidden": true
					}
				},

				"variablePrefix": {
					"title": "Variablen-Prefix",
					"description": "Erzeugt werden 'V_Status_&lt;pref&gt;' und 'V_Input_&lt;pref&gt;_Val'",
					"type": "string",
					"default": "1a",
					"options": {
						"grid_columns": 12,
						"grid_break": true
					}
				}

			}
		}
	}
}
